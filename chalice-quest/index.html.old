<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chalice Quest</title>
  <style>
    :root{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;color:#f5eccb;background:#0b111d}
    *{box-sizing:border-box} body{margin:0;min-height:100vh;background:radial-gradient(circle at 50% -20%,#263b46,#0b111d 66%)}
    .shell{max-width:1450px;margin:auto;padding:22px} header{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:16px}
    .eyebrow{color:#f3b860;font-size:12px;font-weight:800;letter-spacing:.28em;text-transform:uppercase} h1{margin:3px 0 0;font-size:clamp(28px,4vw,52px);line-height:1;letter-spacing:.08em;text-shadow:4px 4px #403424}
    .top-actions{display:flex;gap:8px} button{font:inherit;cursor:pointer} .top-actions button,.action{border:2px solid #b59457;background:#222b35;color:#ffedbf;padding:9px 14px;box-shadow:3px 3px 0 #080d13;font-weight:800}
    button:hover,button:focus-visible{background:#485548;outline:2px solid #f7cf82;outline-offset:2px}
    .layout{display:flex;flex-wrap:nowrap;gap:18px;align-items:flex-start}.layout>div{flex:1 1 0;min-width:0}.layout>aside{flex:0 0 clamp(210px,24vw,290px)}.screen-frame{padding:9px;background:#161e27;border:3px solid #aa814b;box-shadow:0 18px 55px #0009,inset 0 0 0 3px #302a28}
    canvas{display:block;width:100%;height:auto;aspect-ratio:3/2;image-rendering:pixelated;background:#8f8b8f;touch-action:none}
    .ticker{display:flex;gap:12px;justify-content:space-between;border:2px solid #596451;border-top:0;padding:10px 12px;min-height:48px;background:#182622;color:#dfdfb0;font-size:13px}.ticker strong{color:#f5c879}
    aside{display:grid;gap:12px}.card{border:2px solid #596451;background:#17242b;padding:14px;box-shadow:4px 4px 0 #080d13}.card h2{margin:0 0 11px;color:#f3c77c;font-size:13px;letter-spacing:.15em;text-transform:uppercase}.card p{font-size:12px;line-height:1.6;margin:8px 0;color:#c8d0bc}
    .item{display:flex;gap:10px;align-items:center;min-height:44px;color:#fff1c8}.item-icon{width:27px;height:27px;display:grid;place-items:center;background:transparent center / contain no-repeat;font-size:18px;image-rendering:pixelated}
    .map{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:3px}.map>span{position:relative;aspect-ratio:1.25;display:grid;place-items:center;background:#273a3d;border:1px solid #45605b;color:#becdb6;font-size:16px}.map>span.current{background:#32474a;color:#f6e2a6;border-color:#ffe0a5;box-shadow:inset 0 0 0 1px #ffe0a5}.map>span.castle-gold{color:#d2d240;text-shadow:0 1px 2px #000}.map>span.castle-white{color:#fff;text-shadow:0 1px 2px #000}.map>span.castle-black{color:#000;text-shadow:0 0 3px #fff,0 0 5px #fff}.map>span.unseen:not(.castle-gold):not(.castle-white):not(.castle-black){color:#668077}.map .dragon-icons{position:absolute;top:1px;left:1px;display:flex;justify-content:flex-start;gap:1px;pointer-events:none}.map .dragon-icon{width:12px;height:20px;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(0 0 2px #fff9)}.map .dragon-icon.dead{opacity:.5}.map .dragon-icon-fallback{font-size:13px;line-height:19px}.map .map-item-icons{position:absolute;bottom:1px;left:1px;right:1px;display:flex;justify-content:center;gap:1px;pointer-events:none}.map .map-item-icon{display:grid;place-items:center;min-width:12px;height:11px;background:#17242bd9;border-radius:2px;font:bold 11px/1 monospace}.map .map-bat{position:absolute;z-index:3;width:11px;height:11px;display:grid;place-items:center;background:rgba(230,226,204,.5);color:#000;font:900 10px/1 monospace;border-radius:1px;transform:translate(-50%,-50%);pointer-events:none}
    .map>span.empty{visibility:hidden}.map .map-castle-icon{display:block;line-height:1;transform:translateY(-5px)}
    .map .map-item-treasure{font-family:'Segoe UI Symbol',monospace;font-size:12px}
    .map .map-item-chalice{text-shadow:none}
    .map .map-item-key{text-shadow:0 1px 2px #000}
    .map .map-item-black-key{color:#000;background:linear-gradient(#fff,#fff) center 1px / 7px 8px no-repeat,#45605B;text-shadow:none}
    .map .map-item-bridge{font-size:calc(11px - 2pt)}
    .maze-map-wrap{position:relative;margin-top:11px}.maze-map{position:relative;display:grid;grid-template-columns:repeat(2,calc(20% - 2.4px));gap:3px}.maze-map>span{position:relative;display:grid;place-items:center;aspect-ratio:1.25;background:#273a3d;border:1px solid #45605b;color:#becdb6;font:bold 11px monospace}.maze-map>span.current{background:#32474a;color:#f6e2a6;border-color:#ffe0a5;box-shadow:inset 0 0 0 1px #ffe0a5}.maze-map>span.unseen{color:#668077}.maze-map>span.empty{visibility:hidden}.maze-map-label{position:absolute;left:calc(40% + 8px);top:50%;transform:translateY(-50%);color:#becdb6;font:bold 11px monospace;white-space:nowrap}
    .map>span.maze-room::before,.maze-map>span.maze-room::before{content:"";position:absolute;inset:0;background:url("maze-watermark.png") center/100% 100% no-repeat;opacity:.16;pointer-events:none}
    .maze-map .dragon-icons{position:absolute;top:1px;left:1px;display:flex;gap:1px;pointer-events:none}.maze-map .dragon-icon{width:12px;height:20px;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(0 0 2px #fff9)}.maze-map .dragon-icon.dead{opacity:.5}.maze-map .dragon-icon-fallback{font-size:13px;line-height:19px}.maze-map .map-item-icons{position:absolute;bottom:1px;left:1px;right:1px;display:flex;justify-content:center;gap:1px;pointer-events:none}.maze-map .map-item-icon{display:grid;place-items:center;min-width:12px;height:11px;background:#17242bd9;border-radius:2px;font:bold 11px/1 monospace}.maze-map .map-bat{position:absolute;z-index:3;width:11px;height:11px;display:grid;place-items:center;background:rgba(230,226,204,.5);color:#000;font:900 10px/1 monospace;border-radius:1px;transform:translate(-50%,-50%);pointer-events:none}
    .maze-map .map-item-treasure{font-family:'Segoe UI Symbol',monospace;font-size:12px}.maze-map .map-item-chalice{text-shadow:none}.maze-map .map-item-key{text-shadow:0 1px 2px #000}.maze-map .map-item-black-key{color:#000;background:linear-gradient(#fff,#fff) center 1px / 7px 8px no-repeat,#45605B;text-shadow:none}.maze-map .map-item-bridge{font-size:calc(11px - 2pt)}
    .hints-toggle{display:inline-block;margin-top:8px;color:#f3c77c;font-size:12px;text-decoration:underline}.hints-toggle:focus-visible{outline:2px solid #f7cf82;outline-offset:3px}.hints{margin-top:10px;padding-top:10px;border-top:1px solid #596451;font-size:12px;color:#d8dfc9}.hints[hidden]{display:none}.hints h3{margin:9px 0 4px;color:#f3c77c;font-size:11px;letter-spacing:.1em;text-transform:uppercase}.hints ul{list-style:none;margin:0;padding:0}.hints li{margin:3px 0;line-height:1.5}.hints strong{color:#fff1c8}
    .legend{font-size:11px!important}.controls{display:grid;grid-template-columns:repeat(3,54px);gap:5px;justify-content:center;grid-template-areas:". up ." "left down right";margin-top:6px}.controls button{height:46px;border:2px solid #a58c60;background:#263b3e;color:#fbe7af;font-size:20px;font-weight:900;touch-action:none}.controls [data-dir=up]{grid-area:up}.controls [data-dir=left]{grid-area:left}.controls [data-dir=down]{grid-area:down}.controls [data-dir=right]{grid-area:right}.mobile-actions{display:flex;gap:6px;justify-content:center;margin-top:10px}.mobile-actions button{padding:8px 11px;border:2px solid #a58c60;background:#263b3e;color:#fbe7af;font-weight:800}
    .overlay{position:absolute;inset:0;z-index:2;display:grid;place-items:center;background:#07100dcc;padding:20px}.overlay[hidden]{display:none}.panel{max-width:510px;border:3px solid #e0b975;background:#162823;padding:25px;text-align:center;box-shadow:0 0 0 6px #101c1a,0 20px 70px #000b}.panel .crest{font-size:48px;color:#ffd779}.panel h2{font-size:26px;letter-spacing:.1em;margin:9px 0}.panel p{font-size:13px;line-height:1.7;color:#d6dcc5}.panel button{margin-top:13px;border:2px solid #e7c082;background:#b58437;color:#0e1d1a;font-weight:900;padding:11px 25px}.stage{position:relative}.transition-screen{position:absolute;inset:0;z-index:1;width:100%;height:100%;opacity:1;pointer-events:none;transition:opacity .1s ease-in}.transition-screen[hidden]{display:none}.transition-screen.fading,.overlay.title.fading{opacity:0}.overlay.title.fading{transition:opacity .1s ease-in}.overlay.transitioning button{pointer-events:none}
    .overlay.game-over{place-items:start center;background:#07100d44;padding:8px;pointer-events:none}.overlay.game-over .panel{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:12px;max-width:100%;padding:8px 12px;border:0;box-shadow:none;pointer-events:auto}.overlay.game-over .crest{display:none}.overlay.game-over h2{font-size:18px;margin:0;white-space:nowrap}.overlay.game-over p{margin:0;font-size:11px}.overlay.game-over button{margin:0;padding:8px 12px;white-space:nowrap}
    .overlay.title{place-items:center;background:transparent;padding:0;pointer-events:none}.overlay.title .panel{max-width:none;padding:0;border:0;background:transparent;box-shadow:none}.overlay.title .crest,.overlay.title #overlayBtn{display:none}.overlay.title h2{margin:0 0 12px;color:#3bd0cc;font:400 clamp(26px,5vw,48px)/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.03em;white-space:nowrap;transform:scaleX(.82)}.overlay.title #overlayText{max-width:520px;margin:0 auto 22px;padding:0 16px;color:#3bd0cc;font:14px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}.mode-options{display:none;gap:10px;justify-content:center}.overlay.title .mode-options{display:flex}.mode-options button{min-width:106px;margin:0;padding:9px 12px;border:1px solid #5a6464;background:#c5c2c2;color:#243032;font-size:17px;box-shadow:none;pointer-events:auto}.mode-options #hardModeBtn{background:#3bd0cc;border-color:#258e8b;color:#123b3b}.mode-options button:disabled{opacity:.55;cursor:default}.mode-options button:disabled:hover{background:#c5c2c2;outline:0}.mode-options button:focus-visible{outline:3px solid #29e1dc;outline-offset:3px}
    .title-cursor{position:absolute;inset:0;z-index:3;display:none;width:100%;height:100%;background:transparent;pointer-events:none}.overlay.title~.title-cursor{display:block}.overlay.title.fading~.title-cursor{opacity:0;transition:opacity .1s ease-in}
    body.playfield-only{overflow:hidden;background:#8F8B8F}body.playfield-only .shell{width:100vw;height:100dvh;max-width:none;padding:0}body.playfield-only header,body.playfield-only aside,body.playfield-only .ticker{display:none}body.playfield-only .layout,body.playfield-only .layout>div,body.playfield-only .screen-frame{height:100%}body.playfield-only .layout{display:block}body.playfield-only .screen-frame{display:grid;place-items:center;padding:0;border:0;box-shadow:none;background:transparent}body.playfield-only .stage{display:grid;place-items:center;width:min(100vw,150dvh);aspect-ratio:3/2}body.playfield-only canvas{width:100%;height:100%}
    kbd{color:#f4d69d;background:#2b3e3d;padding:1px 4px;border:1px solid #5c6e61}
    @media(max-width:560px){.shell{padding:10px}header{align-items:start}.top-actions{flex-direction:column}.top-actions button{padding:5px 8px;font-size:11px}.ticker{font-size:11px}.panel{padding:15px}.panel h2{font-size:21px}.mode-options{gap:5px}.mode-options button{min-width:0;padding:8px 10px;font-size:12px}}
  </style>
</head>
<body>
<main class="shell">
  <header><div><div class="eyebrow">A tiny kingdom awaits</div><h1>CHALICE QUEST</h1></div><div class="top-actions"><button id="pauseBtn" type="button">PAUSE</button><button id="restartBtn" type="button">NEW QUEST</button></div></header>
  <div class="layout">
    <div>
      <div class="screen-frame">
        <div class="stage">
          <canvas id="game" width="960" height="640" aria-label="Chalice Quest game world"></canvas>
          <canvas id="transitionScreen" class="transition-screen" width="960" height="640" aria-hidden="true" hidden></canvas>
          <div class="overlay" id="overlay">
            <div class="panel">
              <div class="crest">♛</div>
              <h2 id="overlayTitle">THE ENCHANTED CHALICE</h2>
              <p id="overlayText">Explore the kingdom, open its castles, and carry the chalice home to the Golden Castle. Beware the dragons and the thieving bat. Press Tab for help.</p>
              <button id="overlayBtn" type="button">BEGIN QUEST</button>
              <div class="mode-options" role="group" aria-label="Choose game mode"><button type="button" disabled title="Easy mode is coming soon">Easy</button><button type="button" id="hardModeBtn">Hard</button><button type="button" disabled title="Random mode is coming soon">Random</button></div>
            </div>
          </div>
          <canvas id="titleCursor" class="title-cursor" width="960" height="640" aria-hidden="true"></canvas>
        </div>
      </div>
      <div class="ticker"><span id="roomName">THE GOLDEN APPROACH</span><strong id="message">Find the chalice. Bring it home.</strong></div>
    </div>
    <aside>
      <section class="card"><h2>Kingdom map</h2><div class="map" id="map"></div><div class="maze-map-wrap"><div class="maze-map" id="mazeMap" aria-label="Western maze"></div><span class="maze-map-label">Western Maze</span></div><p class="legend">◆ You · ♜ castles</p><a href="#" class="hints-toggle" id="hintsToggle" aria-controls="hints" aria-expanded="false">Show hints</a><div class="hints" id="hints" hidden><h3>Keys</h3><ul><li><strong>Gold key</strong> — <span id="hintGoldKey"></span></li><li><strong>White key</strong> — <span id="hintWhiteKey"></span></li><li><strong>Black key</strong> — <span id="hintBlackKey"></span></li></ul><h3>Objects</h3><ul><li><strong>Sword</strong> — <span id="hintSword"></span></li><li><strong>Magnet</strong> — <span id="hintMagnet"></span></li><li><strong>Bridge</strong> — <span id="hintBridge"></span></li><li><strong>Maze bridge</strong> — <span id="hintBridge2"></span></li><li><strong>Chalice</strong> — <span id="hintChalice"></span></li></ul></div></section>
      <section class="card"><h2>Carrying</h2><div class="item"><span class="item-icon" id="itemIcon">□</span><strong id="itemName">Nothing</strong></div><p>Touch an item to take it. You can carry only one. <kbd>Space</kbd> drops it or places the bridge at the gap. Stand by a placed bridge's leg and press <kbd>Space</kbd> to pick it up. Carry a matching key into a castle gate to open it. Push the key ahead of you out of the castle to keep the gate open. Pull it behind you out of the castle to close the gate.</p></section>
      <section class="card"><h2>Controls</h2><p><kbd>W A S D</kbd> or <kbd>↑ ← ↓ →</kbd> move · <kbd>Space</kbd> drop, place, or pick up bridge · <kbd>M</kbd> use magnet · <kbd>P</kbd> pause · <kbd>R</kbd> new quest · <kbd>Tab</kbd> switch view.</p><div class="controls"><button data-dir="up" aria-label="Move up">↑</button><button data-dir="left" aria-label="Move left">←</button><button data-dir="down" aria-label="Move down">↓</button><button data-dir="right" aria-label="Move right">→</button></div><div class="mobile-actions"><button id="dropBtn">DROP</button><button id="magnetBtn">MAGNET</button></div></section>
    </aside>
  </div>
</main>
<script src="game.js"></script>
</body>
</html>
